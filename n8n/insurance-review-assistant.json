        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {request_id:$('Review Assistant Intake').first().json.body.request_id,output:$json.output??$json.text} }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
